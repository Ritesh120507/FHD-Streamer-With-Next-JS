# Firebase Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env with actual keys to GitHub!

FIREBASE_API_KEY=AIzaSyExampleKey123456789
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: TURN Relay Server (Required to stream across different networks / mobile / firewalls)
# Option A: Free Metered.ca TURN (50 GB / Month free - Sign up at https://www.metered.ca/tools/openrelay/)
METERED_APP_NAME=
METERED_API_KEY=

# Option B: Custom TURN Server (CoTURN, Twilio, Cloudflare, Xirsys)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

