rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // NovaStream WebRTC Signaling & E2EE Chat Security Rules
    // =========================================================================
    // Allows streamers and viewers to exchange WebRTC SDP offers, answers,
    // and ICE candidates (direct P2P signaling) across any network.
    // =========================================================================

    // Match stream rooms and ALL nested signaling subcollections recursively
    match /rooms/{roomId} {
      // Room document (contains offer, answer, host/viewer info, ICE servers)
      allow read, write: if true;

      // WebRTC Streamer ICE candidates subcollection
      match /callerCandidates/{candidateId} {
        allow read, write: if true;
      }

      // WebRTC Viewer ICE candidates subcollection
      match /calleeCandidates/{candidateId} {
        allow read, write: if true;
      }

      // Multi-Viewer Mesh Signaling (Dedicated peer connection per viewer)
      match /viewers/{viewerId} {
        allow read, write: if true;

        match /callerCandidates/{candidateId} {
          allow read, write: if true;
        }

        match /calleeCandidates/{candidateId} {
          allow read, write: if true;
        }

        match /{viewerChildren=**} {
          allow read, write: if true;
        }
      }

      // Real-time End-to-End Encrypted (E2EE) live chat
      match /messages/{messageId} {
        allow read, write: if true;
      }

      // Recursive fallback for any future subcollections
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

